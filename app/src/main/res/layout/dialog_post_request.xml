<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface_white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blood Type Needed"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinner_blood_type"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#F5F5F5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Units Needed (1–20)"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/et_units"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="1"
        android:inputType="number"
        android:background="#F5F5F5"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="URGENCY LEVEL"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_muted"
        android:letterSpacing="0.08"
        android:layout_marginTop="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_standard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Standard"
            android:tag="STANDARD"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/status_green"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_high"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="High"
            android:tag="HIGH"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="@color/status_orange"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_critical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Critical"
            android:tag="CRITICAL"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/status_red"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HOSPITAL"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_muted"
        android:letterSpacing="0.08"
        android:layout_marginTop="20dp" />

    <Spinner
        android:id="@+id/spinner_hospital"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#F5F5F5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notes (optional)"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/et_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginTop="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btn_cancel_dialog"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/btn_post_request"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Post Request 🩸"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/red_mid" />
    </LinearLayout>
</LinearLayout>