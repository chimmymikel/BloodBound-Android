<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Welcome header -->
            <TextView
                android:id="@+id/tv_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome 👋"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track your eligibility and find requests near you."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2">

                <!-- Stat card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_stat1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/border_light"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView
                            android:id="@+id/label_stat1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="YOUR STATUS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            android:letterSpacing="0.08"/>
                        <TextView
                            android:id="@+id/value_stat1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="4dp"/>
                        <TextView
                            android:id="@+id/sub_stat1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat card 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_stat2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/border_light"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView
                            android:id="@+id/label_stat2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BLOOD TYPE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            android:letterSpacing="0.08"/>
                        <TextView
                            android:id="@+id/value_stat2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/red_mid"
                            android:layout_marginTop="4dp"/>
                        <TextView
                            android:id="@+id/sub_stat2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Registered at sign-up"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Requests section header -->
            <TextView
                android:id="@+id/tv_requests_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nearby Blood Requests"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="32dp"/>

            <!-- Loading spinner -->
            <ProgressBar
                android:id="@+id/progress_requests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:visibility="gone"/>

            <!-- Error view -->
            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_error_banner"
                android:padding="16dp"
                android:textColor="@color/status_red"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥"
                    android:textSize="48sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No active requests right now"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="12dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="When blood requests matching your blood type are posted, they'll appear here."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Requests RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_requests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>