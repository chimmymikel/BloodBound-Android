<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- ── Decorative orbs (same treatment as RegisterFragment) ── -->
    <View
        android:id="@+id/orb_red"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-160dp"
        android:layout_marginTop="-160dp"
        android:alpha="0.75"
        android:background="@drawable/orb_red" />

    <View
        android:id="@+id/orb_blue"
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-180dp"
        android:layout_marginBottom="-180dp"
        android:alpha="0.75"
        android:background="@drawable/orb_blue" />

    <!-- ── Scrollable content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="56dp"
            android:paddingBottom="40dp">

            <!-- ═══════════════ WORDMARK ═══════════════ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩸"
                    android:textSize="30sp"
                    android:layout_marginEnd="8dp" />

                <!--
                    "Blood" — red  |  "Bound" — blue
                    Replace these two TextViews with your
                    GradientTextView if you need the exact
                    gradient; plain bold colours work perfectly.
                -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blood"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:letterSpacing="-0.03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bound"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:letterSpacing="-0.03" />
            </LinearLayout>

            <!-- ═══════════════ LOGIN CARD ═══════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_card_section"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <!-- Heading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back 👋"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:letterSpacing="-0.02"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="4dp" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to continue to your portal."
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp" />

                <!-- ── Error banner (hidden by default) ── -->
                <LinearLayout
                    android:id="@+id/layout_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="@drawable/bg_error_banner"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠ "
                        android:textSize="14sp"
                        android:textColor="#DC2626"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_error"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#DC2626" />
                </LinearLayout>

                <!-- EMAIL ADDRESS label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:letterSpacing="0.09"
                    android:layout_marginBottom="6dp" />

                <!-- Email field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/border_light"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="name@example.com"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- PASSWORD label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:letterSpacing="0.09"
                    android:layout_marginBottom="6dp" />

                <!-- Password field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/border_light"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sign In button -->
                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Sign In →"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_red_gradient"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="16dp" />

                <!-- Loading indicator (hidden by default) -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- ── OR Divider ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D1D5DB" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OR"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#9CA3AF"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D1D5DB" />
                </LinearLayout>

                <!-- Create Account outlined button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_create_account"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Donor or Requester? Create Account"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:background="@drawable/bg_btn_white_blue_outline"
                    android:stateListAnimator="@null" />

            </LinearLayout>
            <!-- end card -->

            <!-- Back to Home (below card, centred) -->
            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←Back to Home"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:padding="8dp"
                android:layout_gravity="center_horizontal" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>