<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_faint"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Urgency accent bar — full card height, colour set in adapter -->
        <View
            android:id="@+id/view_urgency_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/red_mid"/>

        <!-- Card body -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <!--
              TOP ROW
              ───────────────────────────────────────────────────────
              [Blood badge]  [vertical column]
                             ├─ Hospital name (full width, wraps if long)
                             └─ [Urgency chip] ·· spacer ·· [Right slot]

              Putting the chips INSIDE the same vertical column as the
              hospital name means they are always flush-aligned and never
              appear as a detached floating row.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <!-- Blood type badge -->
                <TextView
                    android:id="@+id/tv_blood_type"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/red_mid"
                    android:background="@drawable/bg_blood_type_badge"
                    tools:text="O+"/>

                <!-- Hospital name + chips column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <!-- Hospital name — full width, never truncated -->
                    <TextView
                        android:id="@+id/tv_hospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/text_primary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Cebu Doctors' University Hospital"/>

                    <!--
                      Chips row — directly below the hospital name inside
                      the same column, so it's visually anchored to it.
                      Urgency chip left-aligned; right slot pushed to end.
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <!-- Urgency chip -->
                        <TextView
                            android:id="@+id/tv_urgency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_status_badge"
                            tools:text="STANDARD"/>

                        <!-- Pushes right slot to the far end -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <!--
                          RIGHT SLOT — FrameLayout so Commit and pill
                          occupy the exact same space; card never reflows.
                          minWidth on both views keeps it stable.
                        -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <!-- ⏳ Xd left — shown when NOT eligible -->
                            <TextView
                                android:id="@+id/tv_request_expiry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:minWidth="80dp"
                                android:gravity="center"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:background="@drawable/bg_pill_expiry"
                                android:visibility="visible"
                                tools:text="⏳ 14d left"/>

                            <!-- Commit — shown when eligible -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_commit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="Commit"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/surface_white"
                                android:minWidth="80dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="6dp"
                                app:backgroundTint="@color/red_mid"
                                app:cornerRadius="10dp"
                                android:visibility="gone"
                                tools:visibility="gone"/>

                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_faint"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"/>

            <!--
              META SECTION
              ─────────────────────────────────────────────────────
              Three separate lines — each gets its full width.
              Nothing is truncated, nothing competes for space.
            -->
            <TextView
                android:id="@+id/tv_units"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="1 unit needed"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tv_contact_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    tools:text="🔒 Hidden until committed"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"/>

                <TextView
                    android:id="@+id/tv_anonymous_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    tools:text="👤 Anonymous"/>

            </LinearLayout>

            <!-- Timestamp — own full line, never truncated -->
            <TextView
                android:id="@+id/tv_time_ago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_disabled"
                android:layout_marginTop="2dp"
                tools:text="Posted 41d ago · Cebu City"/>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>