<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BloodBound" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/red_mid</item>
        <item name="colorPrimaryVariant">@color/red_dark</item>
        <item name="colorSecondary">@color/blue_mid</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Widget.BloodBound.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">2dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <style name="Widget.BloodBound.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="Widget.BloodBound.Button.Red" parent="Widget.Material3.Button">
        <item name="cornerRadius">13dp</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/red_mid</item>
    </style>

    <style name="Widget.BloodBound.Button.Blue" parent="Widget.Material3.Button">
        <item name="cornerRadius">13dp</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/blue_mid</item>
    </style>

    <style name="Widget.BloodBound.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">13dp</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>